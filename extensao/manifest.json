{
  "manifest_version": 3,
  "name": "Radar de Processos",
  "version": "2.0.1",
  "description": "Digite um CNPJ ou CPF e veja processos judiciais em fontes públicas e gratuitas (DJEN, jus.br, e-SAJ) e sanções do governo. Monitora e avisa de processos novos.",
  "action": {
    "default_title": "Radar de Processos",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "declarativeNetRequest", "clipboardWrite"],
  "host_permissions": [
    "https://comunicaapi.pje.jus.br/*",
    "https://*.pdpj.jus.br/*",
    "https://esaj.tjsp.jus.br/*",
    "https://esaj.tjms.jus.br/*",
    "https://www2.tjal.jus.br/*",
    "https://esaj.tjce.jus.br/*",
    "https://consultasaj.tjam.jus.br/*",
    "https://esaj.tjac.jus.br/*",
    "https://api.portaldatransparencia.gov.br/*",
    "https://brasilapi.com.br/*",
    "https://minhareceita.org/*",
    "https://ovvenrskswsurqzjydby.supabase.co/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://portaldeservicos.pdpj.jus.br/*", "https://www.jus.br/*", "https://jus.br/*"],
      "js": ["pdpj-captura.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://portaldeservicos.pdpj.jus.br/*", "https://www.jus.br/*", "https://jus.br/*"],
      "js": ["pdpj-ponte.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cabecalhos",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
